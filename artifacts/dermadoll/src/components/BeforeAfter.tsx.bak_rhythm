import { useEffect, useState } from "react";

interface Slot { src: string; label: string; category: string; }

const PLACEHOLDERS: Slot[] = [
  { src: "", label: "Natural Lips", category: "Lip Filler" },
  { src: "", label: "Refreshed Eyes", category: "Under-Eye" },
  { src: "", label: "Defined Jawline", category: "Jaw Filler" },
  { src: "", label: "Smooth Skin", category: "Anti-Wrinkle" },
  { src: "", label: "Lifted Brows", category: "Anti-Wrinkle" },
  { src: "", label: "Sculpted Cheeks", category: "Cheek Filler" },
  { src: "", label: "Subtle Volume", category: "Lip Filler" },
  { src: "", label: "Glow Result", category: "Skin Booster" },
];

export default function BeforeAfter() {
  const [slots, setSlots] = useState<Slot[]>(PLACEHOLDERS);

  useEffect(() => {
    fetch("/api/media/config")
      .then(r => r.ok ? r.json() : null)
      .then(data => {
        if (!data) return;
        const arr: Slot[] = [];
        // Prefer galleryImages array if present
        if (Array.isArray(data.galleryImages) && data.galleryImages.length) {
          data.galleryImages.forEach((url: string, i: number) => {
            const fallback = PLACEHOLDERS[i % PLACEHOLDERS.length];
            arr.push({ src: url, label: fallback.label, category: fallback.category });
          });
        }
        // Merge in legacy beforeAfter map (key->url) + baLabels map (key->label)
        if (data.beforeAfter && typeof data.beforeAfter === "object") {
          Object.entries(data.beforeAfter).forEach(([k, url], i) => {
            const lbl = (data.baLabels && data.baLabels[k]) || PLACEHOLDERS[i % PLACEHOLDERS.length].label;
            arr.push({ src: String(url), label: String(lbl), category: "" });
          });
        }
        if (arr.length) setSlots(arr);
      })
      .catch(() => {});
  }, []);

  // Need at least 6 slots for a smooth loop; pad with placeholders if user has fewer
  const filled = slots.length >= 6 ? slots : [...slots, ...PLACEHOLDERS].slice(0, 8);
  // Split into two rows
  const mid = Math.ceil(filled.length / 2);
  const rowA = filled.slice(0, mid);
  const rowB = filled.slice(mid).concat(filled.slice(0, Math.max(0, mid - (filled.length - mid))));
  // Each row needs to be duplicated so the marquee can wrap seamlessly
  const dupA = [...rowA, ...rowA];
  const dupB = [...rowB, ...rowB];

  return (
    <section id="results" style={{
      background: "#FFFFFF",
      padding: "96px 0 112px",
      overflow: "hidden",
      position: "relative",
    }}>
      <style>{`
        @keyframes marqueeLeft {
          from { transform: translateX(0); }
          to   { transform: translateX(-50%); }
        }
        @keyframes marqueeRight {
          from { transform: translateX(-50%); }
          to   { transform: translateX(0); }
        }
        .ba-track {
          display: flex;
          gap: 20px;
          width: max-content;
          will-change: transform;
        }
        .ba-track--left  { animation: marqueeLeft  60s linear infinite; }
        .ba-track--right { animation: marqueeRight 75s linear infinite; }
        .ba-card {
          flex: 0 0 auto;
          width: 280px;
          aspect-ratio: 3 / 4;
          border-radius: 4px;
          overflow: hidden;
          position: relative;
          background: #F2EFEA;
        }
        .ba-card img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          display: block;
        }
        .ba-card__placeholder {
          width: 100%;
          height: 100%;
          display: flex;
          align-items: center;
          justify-content: center;
          color: #B89968;
          font-family: 'Cormorant Garamond', serif;
          font-style: italic;
          font-size: 1rem;
          text-align: center;
          padding: 12px;
        }
        .ba-card__caption {
          position: absolute;
          left: 14px;
          right: 14px;
          bottom: 14px;
          color: #FFFFFF;
          font-family: 'Inter', sans-serif;
          font-size: 11px;
          letter-spacing: 0.15em;
          text-transform: uppercase;
          text-shadow: 0 1px 4px rgba(0,0,0,0.4);
        }
        .ba-row + .ba-row { margin-top: 20px; }
        .ba-fade {
          position: absolute;
          top: 0;
          bottom: 0;
          width: 120px;
          pointer-events: none;
          z-index: 2;
        }
        .ba-fade--l { left: 0;  background: linear-gradient(to right, #FFFFFF, transparent); }
        .ba-fade--r { right: 0; background: linear-gradient(to left,  #FFFFFF, transparent); }
        @media (max-width: 768px) {
          .ba-card { width: 200px; }
        }
      `}</style>

      <div style={{ maxWidth: 1200, margin: "0 auto 56px", padding: "0 32px", textAlign: "center" }}>
        <div style={{
          fontFamily: "'Inter', sans-serif",
          fontSize: 11,
          letterSpacing: "0.3em",
          textTransform: "uppercase",
          color: "#B89968",
          marginBottom: 16,
        }}>RESULTS</div>
        <h2 style={{
          fontFamily: "'Cormorant Garamond', serif",
          fontStyle: "italic",
          fontSize: "clamp(2rem, 5vw, 2.8rem)",
          fontWeight: 400,
          color: "#0E0D0B",
          margin: 0,
        }}>Honest before & afters.</h2>
      </div>

      <div className="ba-fade ba-fade--l" />
      <div className="ba-fade ba-fade--r" />

      <div className="ba-row">
        <div className="ba-track ba-track--left">
          {dupA.map((s, i) => (
            <div key={`a-${i}`} className="ba-card">
              {s.src ? <img src={s.src} alt={s.label} loading="lazy" /> : <div className="ba-card__placeholder">{s.label}</div>}
              {s.src && <div className="ba-card__caption">{s.label}</div>}
            </div>
          ))}
        </div>
      </div>
      <div className="ba-row">
        <div className="ba-track ba-track--right">
          {dupB.map((s, i) => (
            <div key={`b-${i}`} className="ba-card">
              {s.src ? <img src={s.src} alt={s.label} loading="lazy" /> : <div className="ba-card__placeholder">{s.label}</div>}
              {s.src && <div className="ba-card__caption">{s.label}</div>}
            </div>
          ))}
        </div>
      </div>
    </section>
  );
}
